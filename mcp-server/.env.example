# Naim CRM MCP server (Hermes docking port) — SERVER-SIDE ONLY.
# Copy to mcp-server/.env on the VPS. .env is gitignored; never commit it.

SUPABASE_URL=https://your-project-ref.supabase.co

# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# !!  DANGER: the service_role key BYPASSES Row Level Security.              !!
# !!  It must ONLY live here (server env) or in Netlify *functions* env.      !!
# !!  NEVER put it in a VITE_* variable, the React frontend, a browser,      !!
# !!  a WebMCP tool, a chat message, or git. Rotate it immediately if leaked. !!
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
